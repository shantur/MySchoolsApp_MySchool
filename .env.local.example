# ============================================
# Firebase Configuration (LEGACY - Phase 9 Removal)
# ============================================

# Firebase Client SDK Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=myschools-app-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=myschools-app-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=myschools-app-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# Firebase Admin SDK Configuration (Private)
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json
# FIREBASE_ADMIN_KEY_BASE64=

# Firebase Emulator Configuration
USE_FIREBASE_EMULATORS=true

# ============================================
# Application Configuration
# ============================================

# Environment
NODE_ENV=development

# Next.js Configuration
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Management
# Generate a secure random string for production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ============================================
# Migration Notes
# ============================================
# Phase 1-3: Both Firebase and Supabase configs active
# Phase 4-8: Services gradually migrate from Firebase to Supabase
# Phase 9: Firebase config removed, Supabase only
