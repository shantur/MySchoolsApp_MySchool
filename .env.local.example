# ============================================
# Firebase Client SDK Configuration (Public)
# ============================================
# These variables are exposed to the browser (NEXT_PUBLIC_ prefix)
# Get these values from Firebase Console → Project Settings → Your apps
# Or run: cd ../backend/ && firebase apps:sdkconfig web

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=myschools-app-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=myschools-app-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=myschools-app-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here

# ============================================
# Firebase Admin SDK Configuration (Private)
# ============================================
# These variables are server-side only (no NEXT_PUBLIC_ prefix)
# Choose ONE of the two options below:

# Option A: Path to service account JSON file (Development)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_ADMIN_KEY_PATH=./firebase-admin-key.json

# Option B: Base64 encoded service account (Production/CI/CD)
# Generate with: cat firebase-admin-key.json | base64
# FIREBASE_ADMIN_KEY_BASE64=

# ============================================
# Application Configuration
# ============================================

# Environment
NODE_ENV=development

# Next.js Configuration
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Additional Environment Variables
# ============================================

# Session Management
# Generate a secure random string for production
# For development, you can use any string, but use a strong secret in production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# Add any additional environment variables below

# ============================================
# Firebase Emulator Configuration
# ============================================
# Set to 'true' when using Firebase emulators for development/testing
USE_FIREBASE_EMULATORS=true
