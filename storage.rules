rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Attachments storage
    // - Write: Admin only
    // - Read: Authenticated users only
    match /attachments/{schoolId}/{noticeId}/{filename} {
      allow write: if request.auth.token.admin == true;
      allow read: if request.auth != null;
    }
  }
}