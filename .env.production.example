# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# ⚠️ NEVER commit actual .env.production with real credentials!
# This is a template only. Replace all placeholder values.

# ============================================
# Supabase Configuration (PRODUCTION)
# ============================================
# Get these from your Supabase project dashboard:
# https://app.supabase.com/project/{your-project-id}/settings/api

# Public Keys (exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key_here

# Private Keys (server-side only, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key_here

# Direct Database Connection (for migrations)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-id.supabase.co:5432/postgres

# ============================================
# Application Configuration
# ============================================

# Environment
NODE_ENV=production

# Next.js Configuration
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Session Management
# Generate with: openssl rand -base64 64
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_64_CHARACTERS

# ============================================
# CI/CD Configuration
# ============================================
# These should be set as GitHub Secrets or in your deployment platform

# Cloudflare Workers (Phase 6)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ============================================
# Monitoring & Analytics (Optional)
# ============================================
# SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=

# ============================================
# Security Notes
# ============================================
# 1. Use GitHub Secrets for CI/CD
# 2. Use environment variables in hosting platform (Cloudflare, Vercel, etc.)
# 3. Never commit actual credentials to version control
# 4. Rotate secrets regularly
# 5. Use different credentials for staging and production
